{
  "name": "ULHPC-bash",
  "version": "0.8.0",
  "author": "UL HPC Team",
  "summary": "Configure and manage Bourne Again SHell (Bash) dotfiles and profiles",
  "license": "Apache-2.0",
  "source": "https://github.com/ULHPC/puppet-bash",
  "project_page": "https://github.com/ULHPC/puppet-bash",
  "issues_url": "https://github.com/ULHPC/puppet-bash/issues",
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": "> 4.1.0 < 10.0.0"
    },
    {
      "name": "puppetlabs-vcsrepo",
      "version_requirement": ">= 1.3.0 < 8.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 1.2.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "7",
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "7",
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "shell",
    "gnu",
    "bash"
  ]
}

